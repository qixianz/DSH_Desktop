# Python virtual environment
.venv/

# PyInstaller build work directory
pyinstaller-build/

# Build staging output (kept under DSH_Desktop/window/);
# keep the launcher sources (tracked explicitly below)
DSH_Desktop/window/*
!DSH_Desktop/window/webview2_launcher.py
!DSH_Desktop/window/DSH_Desktop.spec
!DSH_Desktop/window/deepseek娘.png
!DSH_Desktop/window/deepseek娘.ico

# Backend repo auto-cloned by 01_dsh-window-build.bat into the root
deepseek-harness/

# Built exe (output of 01_dsh-window-build.bat, lands in the root)
DSH_Desktop.exe
# legacy exe name (pre-rename artifacts)
Deepseek Harness.exe

# Generated build state
last-build.txt
last-commit.txt
# Update-badge persistent state (baseline commit + pending flag, written at runtime)
last-update-seen.txt

# Shared paths file (generated by 01/00 bat, machine-specific)
DSH_Desktop/paths.env

# Runtime data dir (logs / WebView2 user data, created by the launcher)
data/

# Reasonix tooling workspace
.reasonix/

# Python bytecode
__pycache__/
*.pyc

# Release package output (built by 00release.bat)
# Only the two build scripts are tracked (loss-proof against accidental delete);
# everything else (portable tool cache, built exe/installer) is regenerable.
release/*
!release/00_release.bat
!release/DSH_DESKTOP.iss
